# Copy only for a NEW installation. Preserve all existing production secrets.
NODE_ENV=production
DEMO_MODE=false
DEV_MOCK_LOGIN=false
PANEL_DOMAIN=fafa888.uk
ADMIN_DOMAIN=a.fafa888.uk
WEB_ORIGIN=https://fafa888.uk
ADMIN_ORIGIN=https://a.fafa888.uk
# Origin only, never append /api here. Routes already include /api.
API_PUBLIC_URL=https://fafa888.uk
API_PORT=4000
GOOGLE_REDIRECT_URI=https://fafa888.uk/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Owner 初始化使用服务器一次性授权，见 docs/OWNER_SETUP.md；不配置 Google sub。
# Empty = host-only Cookie on the main domain. Admin sends credentialed requests there.
# Preserve an existing controlled parent-domain setting during an upgrade.
COOKIE_DOMAIN=
IMAGE_TAG=
POSTGRES_PASSWORD=
DATABASE_URL=
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=v1
ENCRYPTION_PREVIOUS_KEYS_JSON=
SSH_ALLOWED_TARGETS=
SSH_INTERACTIVE_ENABLED=false
OPENAI_MODEL=gpt-4.1-mini

# Optional Photon-compatible geocoder. Existing secrets/Owner must be preserved.
WLOC_SEARCH_ENABLED=true
WLOC_SEARCH_URL=https://photon.komoot.io/api/

# Optional member email; configure via trusted secrets, never replace existing keys.
# Keep registration closed until real delivery is verified by the account holder.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
