{
  "name": "fafa-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx infra/scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:worker": "tsx apps/worker/src/index.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit.test.ts tests/domain.test.ts tests/nodes.test.ts tests/backup.test.ts tests/wloc.test.ts tests/wloc-device.test.ts",
    "test:integration": "tsx infra/scripts/integration.ts",
    "test:e2e": "playwright test",
    "build": "vite build --config apps/web/vite.config.ts && vite build --config apps/admin/vite.config.ts && tsc --noEmit",
    "security": "tsx infra/scripts/security.ts",
    "verify:backup": "tsx infra/scripts/verify-backup.ts",
    "verify:tls": "tsx infra/scripts/verify-tls.ts",
    "owner:setup": "tsx infra/scripts/owner-setup.ts",
    "nodes:validate": "tsx infra/scripts/validate-nodes.ts",
    "test:member": "tsx infra/scripts/test-member-auth.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/websocket": "11.3.7",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "google-auth-library": "11.3.3",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.68.0",
    "openai": "7.50.0",
    "postgres": "4.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "rehype-highlight": "7.0.2",
    "ssh2": "1.17.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "leaflet": "1.9.4",
    "gcoord": "1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "@types/leaflet": "1.9.20"
  }
}
