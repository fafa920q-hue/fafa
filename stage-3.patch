+-- 012_probe_results: FAFA ONE 2.0 阶段 3（节点探测）.
+-- 新建 probe_results（每次探测一行，只追加，不原地改写历史）；
+-- nodes 补 last_probe_at / last_probe_status（回填缓存，真实来源仍是 probe_results 最新行）。
+-- 不加 group_id；不建 node_groups（001 已有，复用）；不动 node_health_checks。
+-- D-N5 结论 (a)：node_health_checks 自 001 建表后，全仓库无任何应用代码读写
+-- （工作区 grep 仅命中 001 DDL 与 packages/db/src/schema.ts 的 drizzle 导出；
+-- GitHub search_code 对本私库返回 total_count 0，该索引不可靠，不作为反证），
+-- 标记为遗留表；012 仍新建 probe_results 作为唯一探测结果表，不得两套探测结果表并存。
+-- 上传测速：upload_mbps 列存在但本阶段所有写入路径保持 NULL
+-- （上传测速待 Cloudflare 端点在 Kong staging 验证通过后接入，用户决策 (b)）。
+-- ROLLBACK: DROP TABLE probe_results;
+--   ALTER TABLE nodes DROP COLUMN last_probe_status;
+--   ALTER TABLE nodes DROP COLUMN last_probe_at;
+-- （回滚不得 DROP node_groups / node_health_checks，不得动探测以外的任何数据。）
+-- 注意：011 预留给阶段 2（订阅源），本迁移直接编号 012。
+CREATE TABLE probe_results (
+ id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+ node_id uuid NOT NULL REFERENCES nodes(id),
+ probe_point text,
+ target text,
+ started_at timestamptz,
+ finished_at timestamptz,
+ status text NOT NULL CHECK (status IN ('OK','TIMEOUT','FAILED')),
+ latency_ms integer CHECK (latency_ms IS NULL OR latency_ms >= 0),
+ download_mbps numeric CHECK (download_mbps IS NULL OR download_mbps >= 0),
+ upload_mbps numeric CHECK (upload_mbps IS NULL OR upload_mbps >= 0),
+ error_code text,
+ error_message text,
+ created_at timestamptz NOT NULL DEFAULT now(),
+ CHECK (
+  (status = 'OK' AND latency_ms IS NOT NULL) OR
+  (status <> 'OK' AND latency_ms IS NULL)
+ )
+);
+CREATE INDEX probe_results_node_time ON probe_results(node_id, created_at DESC);
+CREATE INDEX probe_results_started ON probe_results(started_at DESC);
+ALTER TABLE nodes ADD COLUMN last_probe_at timestamptz;
+ALTER TABLE nodes ADD COLUMN last_probe_status text NOT NULL DEFAULT 'UNPROBED'
+ CHECK (last_probe_status IN ('UNPROBED','OK','TIMEOUT','FAILED'));
