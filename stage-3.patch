+describe('classifyProbeError：超时与失败区分', () => {
+  it('超时错误 → TIMEOUT', () => {
+    expect(
+      classifyProbeError(new Error('Connection timed out after 30000ms')),
+    ).toEqual({
+      status: 'TIMEOUT',
+      errorCode: 'TIMEOUT',
+      errorMessage: '探测超时，未收到节点响应',
+    });
+    expect(
+      classifyProbeError(new Error('connect ETIMEDOUT 1.2.3.4:443')).status,
+    ).toBe('TIMEOUT');
+  });
+
+  it('VMess 时间偏差 → FAILED / CLOCK_SKEW，并含时间同步提示', () => {
+    const out = classifyProbeError(
+      new Error('server clock skew: VMess time difference too large'),
+    );
+    expect(out.status).toBe('FAILED');
+    expect(out.errorCode).toBe('CLOCK_SKEW');
+    expect(out.errorMessage).toContain('时间同步');
+    expect(out.errorMessage).toContain('120 秒');
+  });
+
+  it('DNS 解析失败 → FAILED / DNS_ERROR', () => {
+    const out = classifyProbeError(
+      new Error('getaddrinfo ENOTFOUND node.example.com'),
+    );
+    expect(out).toEqual({
+      status: 'FAILED',
+      errorCode: 'DNS_ERROR',
+      errorMessage: '域名解析失败',
+    });
+  });
+
+  it('认证失败 → FAILED / AUTH_FAILED', () => {
+    const out = classifyProbeError(new Error('password incorrect'));
+    expect(out.status).toBe('FAILED');
+    expect(out.errorCode).toBe('AUTH_FAILED');
+    expect(out.errorMessage).toContain('认证失败');
+  });
+
+  it('TLS 握手失败 → FAILED / PROTOCOL_ERROR', () => {
+    const out = classifyProbeError(
+      new Error('TLS handshake failure: certificate verify failed'),
+    );
+    expect(out.status).toBe('FAILED');
+    expect(out.errorCode).toBe('PROTOCOL_ERROR');
+  });
+
+  it('连接被拒 → FAILED / PROTOCOL_ERROR，且失败不标在线', () => {
+    const out = classifyProbeError(
+      new Error('connect ECONNREFUSED 1.2.3.4:443'),
+    );
+    expect(out.status).toBe('FAILED');
+    expect(out.status).not.toBe('OK');
+  });
+
+  it('未知错误 → FAILED / PROTOCOL_ERROR（默认分支）', () => {
+    expect(classifyProbeError(new Error('something weird'))).toEqual({
+      status: 'FAILED',
+      errorCode: 'PROTOCOL_ERROR',
+      errorMessage: '节点连接失败',
+    });
+    expect(classifyProbeError('plain string failure').status).toBe('FAILED');
+  });
+
+  it('分类结果不含凭据：错误原文里的假 Token/UUID/密码不得出现在返回文案里', () => {
+    const leaked = [
+      'request timeout after 5000ms; token sk-test-fixture-not-real',
+      `auth failed for uuid ${FIXTURE_UUID}`,
+      'login failed: password=fixture-password-not-real',
