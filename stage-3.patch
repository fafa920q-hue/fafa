+// FAFA ONE 探测服务：独立进程，只监听回环地址，供 Worker 经 HTTP 调用。
+// 不碰数据库、不读节点凭据落盘；请求体里的节点配置只在内存中流转，绝不记日志。
+// Mihomo 二进制缺失时不崩溃循环：HTTP 服务仍起，/probe 返回 503，
+// Worker 按现有退避重试，等二进制就位后自动恢复。
+import {
+  createServer,
+  type IncomingMessage,
+  type ServerResponse,
+} from 'node:http';
+import { z } from 'zod';
+import { MihomoClient, probeNodes } from './mihomo';
+import { PROBE_DELAY_TARGET, probeSpeedUrl } from './probe';
+const HOST = process.env.PROBE_HOST || '127.0.0.1';
+const PORT = Number(process.env.PROBE_PORT || 19090);
+const MIHOMO_BIN = process.env.MIHOMO_BIN || './bin/mihomo';
+const CONTROLLER_PORT = Number(process.env.MIHOMO_CONTROLLER_PORT || 9090);
+const MIXED_PORT = Number(process.env.PROBE_MIXED_PORT || 7890);
+if (HOST !== '127.0.0.1' && HOST !== '::1') {
+  console.error('PROBE_HOST 只允许回环地址，拒绝启动');
+  process.exit(1);
+}
+const probeBodySchema = z.object({
+  nodes: z
+    .array(
+      z.object({
+        id: z.uuid(),
+        name: z.string().min(1).max(200),
+        node: z.record(z.string(), z.unknown()),
+      }),
+    )
+    .min(1)
+    .max(50),
+  kind: z.enum(['latency', 'speed']).default('latency'),
+  speedBytes: z.number().int().min(1048576).max(10485760).default(5242880),
+  timeoutSeconds: z.number().int().min(5).max(60).default(30),
+});
+function sendJson(res: ServerResponse, status: number, body: unknown) {
+  res.writeHead(status, { 'content-type': 'application/json' });
+  res.end(JSON.stringify(body));
+}
+async function readJsonBody(req: IncomingMessage, limit = 1048576) {
+  const chunks: Buffer[] = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > limit) throw new Error('BODY_TOO_LARGE');
+    chunks.push(chunk as Buffer);
+  }
+  return JSON.parse(Buffer.concat(chunks).toString('utf8'));
+}
+const client = new MihomoClient({
+  bin: MIHOMO_BIN,
+  controllerPort: CONTROLLER_PORT,
+  mixedPort: MIXED_PORT,
+});
+let mihomoReady = false;
+let busy = false;
+try {
+  await client.start();
+  mihomoReady = true;
+  console.log(`FAFA ONE Probe 已启动（Mihomo ${client.version}）`);
+} catch (err) {
+  // 降级运行：不等 Mihomo，/probe 返回 503，Worker 退避重试。
+  console.error(
+    'Mihomo 未就绪，探测服务以降级模式运行（/probe 返回 503）：',
+    err instanceof Error ? err.message : '启动失败',
+  );
+}
+const server = createServer(async (req, res) => {
+  const path = (req.url || '').split('?')[0];
+  if (req.method === 'GET' && path === '/health') {
+    return sendJson(res, 200, {
+      status: mihomoReady ? 'ok' : 'degraded',
+      mihomo: client.version,
+      busy,
+    });
+  }
+  if (req.method === 'POST' && path === '/probe') {
+    if (!mihomoReady)
+      return sendJson(res, 503, {
+        code: 'PROBE_UNAVAILABLE',
+        message: '探测引擎未就绪',
+      });
+    if (busy)
+      return sendJson(res, 409, {
+        code: 'PROBE_BUSY',
+        message: '已有探测任务在进行中',
+      });
+    let body: unknown;
+    try {
+      body = await readJsonBody(req);
+    } catch {
+      return sendJson(res, 400, {
+        code: 'VALIDATION_ERROR',
+        message: '请求体无效',
+      });
+    }
+    const parsed = probeBodySchema.safeParse(body);
+    if (!parsed.success)
+      return sendJson(res, 400, {
+        code: 'VALIDATION_ERROR',
+        message: '请求体不符合要求',
+      });
+    busy = true;
+    try {
+      const { nodes, kind, speedBytes, timeoutSeconds } = parsed.data;
+      const results = await probeNodes(client, nodes, {
+        kind,
+        speedBytes,
+        timeoutSeconds,
+        delayUrl: PROBE_DELAY_TARGET,
+        speedUrl: probeSpeedUrl(speedBytes),
+      });
+      const okCount = results.filter((r) => r.status === 'OK').length;
+      // 只记数量，不记节点 id / 名称 / 任何节点内容。
+      console.log(`探测完成：${results.length} 节点，${okCount} 可用`);
+      return sendJson(res, 200, { results });
+    } catch (err) {
+      console.error(
+        '探测失败（未记录节点内容）：',
+        err instanceof Error ? err.message : '未知错误',
+      );
+      return sendJson(res, 502, {
+        code: 'PROBE_FAILED',
+        message: '探测执行失败',
+      });
+    } finally {
+      busy = false;
+    }
+  }
+  return sendJson(res, 404, { code: 'NOT_FOUND', message: '资源不存在' });
+});
+server.listen(PORT, HOST, () => {
+  console.log(`FAFA ONE Probe 监听 ${HOST}:${PORT}`);
+});
+for (const signal of ['SIGTERM', 'SIGINT'])
+  process.on(signal, async () => {
+    server.close();
+    await client.stop();
+    process.exit(0);
+  });
