+// Mihomo 外部控制器客户端（v1.19.33 官方静态二进制）。
+// 关键核实结论（2026-11-10，经 DeepWiki Mihomo 源码页 hub/route/configs.go 核实）：
+// - PATCH /configs 只改通用字段（mode / log-level / 端口 / tun 等，configSchema
+//   没有 proxies 字段），不能下发完整代理配置；
+// - PUT /configs 只接受 {path, force}，从磁盘上的配置文件重载，不接受请求体配置。
+// 因此完整代理配置的下发方式是：0600 权限的 tmpfs 临时文件 + PUT /configs，
+// 用完即删。凭据只在内存与该临时文件中出现，绝不记日志。
+import { spawn, type ChildProcess } from 'node:child_process';
+import { writeFile, unlink, stat } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomBytes } from 'node:crypto';
+import net from 'node:net';
+import tls from 'node:tls';
+import { stringify } from 'yaml';
+import {
+  buildMihomoConfig,
+  mihomoProxyName,
+  classifyProbeError,
+  median,
+} from './probe';
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+// 延迟测试单轮超时（与 2026-11-10 Mihomo 实测一致）。
+export const DELAY_TIMEOUT_MS = 5000;
+// 测速只允许这一个白名单 URL（其余 URL 一律拒绝，防 SSRF / 开放代理）。
+const SPEED_HOST = 'speed.cloudflare.com';
+const SPEED_PATH = '/__down';
+async function tmpfsDir() {
+  try {
+    if ((await stat('/dev/shm')).isDirectory()) return '/dev/shm';
+  } catch {
+    // /dev/shm 不可用时退回系统临时目录（容器内 /tmp 同样是 tmpfs）。
+  }
+  return tmpdir();
+}
+export class MihomoClient {
+  readonly secret = randomBytes(32).toString('hex');
+  readonly controllerPort: number;
+  readonly mixedPort: number;
+  version: string | null = null;
+  private bin: string;
+  private child: ChildProcess | null = null;
+  private bootstrapPath: string | null = null;
+  private spawnError: Error | null = null;
+  private stderrTail: string[] = [];
+  constructor(opts: {
+    bin: string;
+    controllerPort?: number;
+    mixedPort?: number;
+  }) {
+    this.bin = opts.bin;
+    this.controllerPort = opts.controllerPort ?? 9090;
+    this.mixedPort = opts.mixedPort ?? 7890;
+  }
+  get running() {
+    return !!this.child && this.child.exitCode == null;
+  }
+  async start() {
+    if (this.child) return;
+    const bootstrap = stringify({
+      'external-controller': `127.0.0.1:${this.controllerPort}`,
+      secret: this.secret,
+      'mixed-port': this.mixedPort,
+      mode: 'rule',
+      'log-level': 'warning',
+    });
+    this.bootstrapPath = join(
+      await tmpfsDir(),
+      `fafa-probe-bootstrap-${process.pid}.yaml`,
+    );
+    await writeFile(this.bootstrapPath, bootstrap, { mode: 0o600 });
+    this.child = spawn(this.bin, ['-f', this.bootstrapPath], {
+      stdio: ['ignore', 'pipe', 'pipe'],
+    });
+    this.child.on('error', (err) => {
+      this.spawnError = err;
+    });
+    this.child.stderr?.on('data', (d: Buffer) => {
+      this.stderrTail.push(d.toString('utf8').slice(-500));
+      if (this.stderrTail.length > 20) this.stderrTail.shift();
+    });
+    const deadline = Date.now() + 30000;
+    while (Date.now() < deadline) {
+      if (this.spawnError) throw this.spawnError;
+      if (this.child.exitCode != null)
+        throw new Error(
+          `MIHOMO_EXITED:${this.child.exitCode} ${this.stderrTail.join(' ')}`.slice(
+            0,
+            500,
+          ),
+        );
+      try {
+        const data = await this.request('/version', 'GET', null, 2000);
+        this.version =
+          typeof data?.version === 'string' ? data.version : 'unknown';
+        return;
+      } catch {
+        await sleep(500);
+      }
+    }
+    throw new Error('MIHOMO_START_TIMEOUT');
+  }
+  async stop() {
+    if (this.child) {
+      this.child.kill('SIGTERM');
+      this.child = null;
+    }
+    if (this.bootstrapPath) {
+      await unlink(this.bootstrapPath).catch(() => {});
+      this.bootstrapPath = null;
+    }
+  }
+  async request(
+    path: string,
+    method: string,
+    body: unknown,
+    timeoutMs = 10000,
+  ): Promise<any> {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), timeoutMs);
+    try {
+      const res = await fetch(
+        `http://127.0.0.1:${this.controllerPort}${path}`,
+        {
+          method,
+          headers: {
+            Authorization: `Bearer ${this.secret}`,
+            ...(body ? { 'content-type': 'application/json' } : {}),
+          },
+          body: body ? JSON.stringify(body) : undefined,
+          signal: controller.signal,
+        },
+      );
+      const text = await res.text();
+      let data: any = null;
+      try {
+        data = text ? JSON.parse(text) : null;
+      } catch {
+        // 非 JSON 响应（如纯文本错误）只取状态码，不透传正文。
+      }
+      if (!res.ok)
+        throw new Error(data?.message || `MIHOMO_HTTP_${res.status}`);
+      return data;
+    } finally {
+      clearTimeout(timer);
+    }
+  }
+  // 下发完整配置：0600 tmpfs 临时文件 + PUT /configs {path, force}，用完即删。
+  async applyConfigYaml(yamlText: string) {
+    const file = join(
+      await tmpfsDir(),
+      `fafa-probe-${process.pid}-${randomBytes(8).toString('hex')}.yaml`,
+    );
+    await writeFile(file, yamlText, { mode: 0o600 });
+    try {
+      await this.request('/configs', 'PUT', { path: file, force: true }, 30000);
+    } finally {
+      await unlink(file).catch(() => {});
+    }
+  }
+  async selectGlobal(proxyName: string) {
+    await this.request('/proxies/GLOBAL', 'PUT', { name: proxyName }, 10000);
+  }
+  // L3 延迟：经该节点向目标 URL 发真实请求并计时（TCP 通不通不算数）。
+  async delay(proxyName: string, url: string, timeoutMs: number) {
+    const data = await this.request(
+      `/proxies/${encodeURIComponent(proxyName)}/delay?url=${encodeURIComponent(url)}&timeout=${timeoutMs}`,
+      'GET',
+      null,
+      timeoutMs + 5000,
+    );
+    if (typeof data?.delay !== 'number')
+      throw new Error(data?.message || 'DELAY_NO_RESULT');
+    return data.delay as number;
+  }
+  async testLatency(proxyName: string, url: string, timeoutMs: number) {
+    const successes: number[] = [];
+    let lastError: unknown = null;
+    for (let round = 0; round < 3; round++) {
+      if (round > 0) await sleep(1000);
+      let value: number | null = null;
+      for (let attempt = 0; attempt < 2; attempt++) {
+        try {
+          value = await this.delay(proxyName, url, timeoutMs);
+          break;
+        } catch (err) {
+          lastError = err;
+          if (attempt === 0) await sleep(1000);
+        }
+      }
+      if (value != null) successes.push(value);
+    }
+    const m = median(successes);
+    return m == null
+      ? { latencyMs: null as number | null, error: lastError }
+      : { latencyMs: m, error: null };
+  }
+  // 经指定节点下载白名单测速文件并计时：通过 Mihomo mixed-port 做 HTTP CONNECT
+  // 隧道，再在隧道上建 TLS、发 GET。只认白名单 URL；单节点上限 maxBytes。
+  async downloadViaProxy(urlStr: string, maxBytes: number, timeoutMs: number) {
+    const u = new URL(urlStr);
+    if (
+      u.protocol !== 'https:' ||
+      u.hostname !== SPEED_HOST ||
+      u.pathname !== SPEED_PATH
+    )
+      throw new Error('SPEED_URL_NOT_ALLOWED');
+    const started = Date.now();
+    const socket = await connectTunnel(
+      '127.0.0.1',
+      this.mixedPort,
+      u.hostname,
+      443,
+      timeoutMs,
+    );
+    const tlsSocket = tls.connect({
+      socket,
+      servername: u.hostname,
+      minVersion: 'TLSv1.2',
+    });
+    await new Promise<void>((resolve, reject) => {
+      const timer = setTimeout(() => {
+        tlsSocket.destroy();
+        reject(new Error('TLS_TIMEOUT'));
+      }, timeoutMs);
+      tlsSocket.once('secureConnect', () => {
+        clearTimeout(timer);
+        resolve();
+      });
+      tlsSocket.once('error', (err) => {
+        clearTimeout(timer);
+        reject(err);
+      });
+    });
+    const path = u.pathname + u.search;
+    tlsSocket.write(
+      `GET ${path} HTTP/1.1\r\nHost: ${u.hostname}\r\nConnection: close\r\nUser-Agent: FAFA-One-Probe/1.0\r\nAccept-Encoding: identity\r\n\r\n`,
+    );
+    const bytes = await readHttpBody(tlsSocket, maxBytes, timeoutMs);
+    const ms = Math.max(1, Date.now() - started);
+    return { bytes, ms, mbps: (bytes * 8) / (ms / 1000) / 1e6 };
+  }
+}
+function connectTunnel(
+  proxyHost: string,
+  proxyPort: number,
+  targetHost: string,
+  targetPort: number,
+  timeoutMs: number,
+): Promise<net.Socket> {
+  return new Promise((resolve, reject) => {
+    const socket = net.connect(proxyPort, proxyHost);
+    const timer = setTimeout(() => {
+      socket.destroy();
+      reject(new Error('PROXY_CONNECT_TIMEOUT'));
+    }, timeoutMs);
+    socket.once('error', (err) => {
+      clearTimeout(timer);
+      reject(err);
+    });
+    socket.once('connect', () => {
+      socket.write(
+        `CONNECT ${targetHost}:${targetPort} HTTP/1.1\r\nHost: ${targetHost}:${targetPort}\r\n\r\n`,
+      );
+    });
+    let buf = Buffer.alloc(0);
+    socket.on('data', (chunk: Buffer) => {
+      buf = Buffer.concat([buf, chunk]);
+      const idx = buf.indexOf('\r\n\r\n');
+      if (idx === -1) return;
+      clearTimeout(timer);
+      socket.removeAllListeners('data');
+      const head = buf.subarray(0, idx).toString('latin1');
+      const status = Number(head.split('\r\n')[0].split(' ')[1]);
+      if (status !== 200) {
+        socket.destroy();
+        reject(new Error(`PROXY_CONNECT_${status}`));
+        return;
+      }
+      const rest = buf.subarray(idx + 4);
+      if (rest.length) socket.unshift(rest);
+      resolve(socket);
+    });
+  });
+}
+// 读 HTTP 响应体并计数（支持 Content-Length 与 chunked；超时或失败时
+// 错误对象带 .bytes，记录已实际下载的字节数，供预算扣减）。
+function readHttpBody(
+  socket: tls.TLSSocket,
+  maxBytes: number,
+  timeoutMs: number,
+): Promise<number> {
+  return new Promise((resolve, reject) => {
+    let done = false;
+    let headerBuf = Buffer.alloc(0);
+    let headersParsed = false;
+    let contentLength: number | null = null;
+    let chunked = false;
+    let body = Buffer.alloc(0);
+    let bodyBytes = 0;
+    const timer = setTimeout(() => fail(new Error('SPEED_TIMEOUT')), timeoutMs);
+    const cleanup = () => {
+      clearTimeout(timer);
+      socket.destroy();
+    };
+    const finish = (bytes: number) => {
+      if (done) return;
+      done = true;
+      cleanup();
+      resolve(bytes);
+    };
+    const fail = (err: Error) => {
+      if (done) return;
+      done = true;
+      cleanup();
+      (err as any).bytes = bodyBytes;
+      reject(err);
+    };
+    const processBody = () => {
+      if (chunked) {
+        for (;;) {
+          const lineEnd = body.indexOf('\r\n');
+          if (lineEnd === -1) return;
+          const size = parseInt(
+            body.subarray(0, lineEnd).toString('ascii').trim(),
+            16,
+          );
+          if (Number.isNaN(size)) {
+            fail(new Error('SPEED_CHUNKED_PARSE'));
+            return;
+          }
+          if (size === 0) {
+            finish(bodyBytes);
+            return;
+          }
+          if (body.length < lineEnd + 2 + size + 2) return;
+          bodyBytes += size;
+          if (bodyBytes >= maxBytes) {
+            finish(Math.min(bodyBytes, maxBytes));
+            return;
+          }
+          body = body.subarray(lineEnd + 2 + size + 2);
+        }
+      }
+      const remaining =
+        contentLength == null
+          ? Infinity
+          : Math.max(0, contentLength - bodyBytes);
+      const take = Math.min(body.length, remaining, maxBytes - bodyBytes);
+      bodyBytes += take;
+      body = body.subarray(take);
+      if (bodyBytes >= maxBytes) {
+        finish(bodyBytes);
+        return;
+      }
+      if (contentLength != null && bodyBytes >= contentLength) {
+        finish(bodyBytes);
+      }
+    };
+    socket.on('data', (chunk: Buffer) => {
+      if (done) return;
+      if (!headersParsed) {
+        headerBuf = Buffer.concat([headerBuf, chunk]);
+        const idx = headerBuf.indexOf('\r\n\r\n');
+        if (idx === -1) return;
+        const head = headerBuf.subarray(0, idx).toString('latin1');
+        const status = Number(head.split('\r\n')[0].split(' ')[1]);
+        if (status !== 200) {
+          fail(new Error(`SPEED_HTTP_${status}`));
+          return;
+        }
+        const cl = /content-length:\s*(\d+)/i.exec(head);
+        contentLength = cl ? Number(cl[1]) : null;
+        chunked = /transfer-encoding:\s*chunked/i.test(head);
+        headersParsed = true;
+        body = headerBuf.subarray(idx + 4);
+        processBody();
+      } else {
+        body = Buffer.concat([body, chunk]);
+        processBody();
+      }
+    });
+    socket.on('end', () => {
+      if (!done) finish(bodyBytes);
+    });
+    socket.on('error', fail);
+  });
+}
+export type ProbeInput = { id: string; name: string; node: any };
+export type ProbeResult = {
+  id: string;
+  status: 'OK' | 'TIMEOUT' | 'FAILED';
+  latencyMs: number | null;
+  downloadMbps: number | null;
+  uploadMbps: null;
+  errorCode: string | null;
+  errorMessage: string | null;
+  bytesUsed: number;
+  startedAt: string;
+  finishedAt: string;
+};
+// 一批节点：先一次下发整批配置测延迟；kind=speed 时再对延迟 OK 的节点
+// 逐个切全局单节点出站做下载测速。调用方保证一次只有一个 probeNodes 在跑
+//（Mihomo 配置是全局状态，并发会互相覆盖；HTTP 层用 PROBE_BUSY 挡并发）。
+export async function probeNodes(
+  client: MihomoClient,
+  inputs: ProbeInput[],
+  opts: {
+    kind: 'latency' | 'speed';
+    speedBytes: number;
+    timeoutSeconds: number;
+    delayUrl: string;
+    speedUrl: string;
+  },
+): Promise<ProbeResult[]> {
+  const results: ProbeResult[] = [];
+  const valid: ProbeInput[] = [];
+  for (const input of inputs) {
+    const n = input?.node;
+    const now = new Date().toISOString();
+    if (
+      !n ||
+      typeof n.host !== 'string' ||
+      !n.port ||
+      typeof n.protocol !== 'string' ||
+      typeof n.credential !== 'string'
+    ) {
+      results.push({
+        id: input?.id,
+        status: 'FAILED',
+        latencyMs: null,
+        downloadMbps: null,
+        uploadMbps: null,
+        errorCode: 'PROTOCOL_ERROR',
+        errorMessage: '节点配置不完整',
+        bytesUsed: 0,
+        startedAt: now,
+        finishedAt: now,
+      });
+    } else {
+      valid.push(input);
+    }
+  }
+  if (!valid.length) return results;
+  const base = {
+    controllerSecret: client.secret,
+    controllerPort: client.controllerPort,
+    mixedPort: client.mixedPort,
+  };
+  await client.applyConfigYaml(buildMihomoConfig(valid, base));
+  for (let i = 0; i < valid.length; i++) {
+    const input = valid[i];
+    const startedAt = new Date().toISOString();
+    const lat = await client.testLatency(
+      mihomoProxyName(input.name, i),
+      opts.delayUrl,
+      DELAY_TIMEOUT_MS,
+    );
+    const finishedAt = new Date().toISOString();
+    if (lat.latencyMs == null) {
+      const c = classifyProbeError(lat.error);
+      results.push({
+        id: input.id,
+        status: c.status,
+        latencyMs: null,
+        downloadMbps: null,
+        uploadMbps: null,
+        errorCode: c.errorCode,
+        errorMessage: c.errorMessage,
+        bytesUsed: 0,
+        startedAt,
+        finishedAt,
+      });
+    } else {
+      results.push({
+        id: input.id,
+        status: 'OK',
+        latencyMs: lat.latencyMs,
+        downloadMbps: null,
+        uploadMbps: null,
+        errorCode: null,
+        errorMessage: null,
+        bytesUsed: 0,
+        startedAt,
+        finishedAt,
+      });
+    }
+  }
+  if (opts.kind === 'speed') {
+    for (const r of results.filter((x) => x.status === 'OK')) {
+      const input = valid.find((v) => v.id === r.id)!;
+      // 单节点全局模式：配置里只剩该节点（下标恒为 0），切 GLOBAL 组后下载。
+      await client.applyConfigYaml(
+        buildMihomoConfig([input], { ...base, mode: 'global' }),
+      );
+      await client.selectGlobal(mihomoProxyName(input.name, 0));
+      try {
+        const dl = await client.downloadViaProxy(
+          opts.speedUrl,
+          opts.speedBytes,
+          opts.timeoutSeconds * 1000,
+        );
+        r.downloadMbps = Math.round(dl.mbps * 10) / 10;
+        r.bytesUsed = dl.bytes;
+      } catch (err) {
+        // 测速失败不推翻已确认的延迟可用：保留 OK，download 留空并记原因。
+        r.errorCode = 'SPEED_FAILED';
+        r.errorMessage = '下载测速失败，延迟正常';
+        r.bytesUsed = (err as any)?.bytes || 0;
+      }
+      r.finishedAt = new Date().toISOString();
+    }
+  }
+  return results;
+}
