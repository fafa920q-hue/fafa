+// apps/probe 纯函数：错误分类、中位数、探测资格、Mihomo 配置组装。
+// 本文件不做 I/O、不读环境变量、不记日志；凭据只在内存中流转，绝不输出。
+import { stringify } from 'yaml';
+
+// 与 apps/api/src/probe.ts 的同名常量保持一致（探测组件不依赖 API 包，
+// 改动任一处时须同步另一处）。
+export const PROBE_DELAY_TARGET = 'https://www.gstatic.com/generate_204';
+export const probeSpeedUrl = (bytes: number) =>
+  `https://speed.cloudflare.com/__down?bytes=${bytes}`;
+// Mihomo 延迟/测速只认 L3 结果（经节点的真实请求）：
+// TCP 通不通不作为可用依据；失败的节点一律不标在线。
+export type ProbeOutcome = {
+  status: 'OK' | 'TIMEOUT' | 'FAILED';
+  errorCode: string | null;
+  errorMessage: string | null;
+};
+// 只存分类后的固定文案，不把上游原始错误文本写入数据库
+//（上游文本可能含节点名以外的信息；凭据绝不出现在这里）。
+export function classifyProbeError(err: unknown): ProbeOutcome {
+  const message =
+    err instanceof Error ? err.message : typeof err === 'string' ? err : '';
+  if (/timeout|timed out|ETIMEDOUT|abort|deadline exceeded/i.test(message))
+    return {
+      status: 'TIMEOUT',
+      errorCode: 'TIMEOUT',
+      errorMessage: '探测超时，未收到节点响应',
+    };
+  if (
+    /clock|time (sync|skew|difference|offset)|timestamp|vmess.*time/i.test(
+      message,
+    )
+  )
+    return {
+      status: 'FAILED',
+      errorCode: 'CLOCK_SKEW',
+      errorMessage:
+        '节点时间偏差过大：请检查节点服务器时间同步（VMess 要求偏差在约 120 秒内）',
+    };
+  if (/ENOTFOUND|EAI_AGAIN|getaddrinfo|DNS|domain.*resolv/i.test(message))
+    return {
+      status: 'FAILED',
+      errorCode: 'DNS_ERROR',
+      errorMessage: '域名解析失败',
+    };
+  if (
+    /auth|unauthori[sz]ed|password|credential|uuid.*invalid|alterId|cipher|method/i.test(
+      message,
+    )
+  )
+    return {
+      status: 'FAILED',
+      errorCode: 'AUTH_FAILED',
+      errorMessage: '节点认证失败：请检查凭据与加密方式',
+    };
+  if (/tls|ssl|certificate|SNI/i.test(message))
+    return {
+      status: 'FAILED',
+      errorCode: 'PROTOCOL_ERROR',
+      errorMessage: 'TLS 握手失败：请检查 SNI 与证书配置',
+    };
+  if (/refused|reset|unreachable|network|ECONN/i.test(message))
+    return {
+      status: 'FAILED',
+      errorCode: 'PROTOCOL_ERROR',
+      errorMessage: '节点服务器不可达',
+    };
+  return {
+    status: 'FAILED',
+    errorCode: 'PROTOCOL_ERROR',
+    errorMessage: '节点连接失败',
+  };
+}
+export function median(values: number[]): number | null {
+  if (!values.length) return null;
+  const sorted = [...values].sort((a, b) => a - b);
+  const mid = Math.floor(sorted.length / 2);
+  return sorted.length % 2
+    ? sorted[mid]
+    : Math.round((sorted[mid - 1] + sorted[mid]) / 2);
+}
+// 与 apps/api/src/probe.ts 的 probeEligibleNodeRows 相同口径的 JS 复核
+//（Worker 已在 SQL 层过滤；此处是探测组件侧的防御性二次检查）。
+export function isProbeEligible(
+  node: { data?: any },
+  source: { data?: any },
+): boolean {
+  const n = node?.data || {};
+  const s = source?.data || {};
+  if (n.enabled === false) return false;
+  if (s.enabled === false) return false;
+  if (s.expiresAt && new Date(s.expiresAt) <= new Date()) return false;
+  if (s.kind === 'OWNED_NODE') return true;
+  return (
+    s.authorized === true &&
+    s.redistributionAuthorized === true &&
+    Boolean(s.authorizationReference?.trim())
+  );
+}
+// 同一批次内 Mihomo 代理名必须唯一；用下标后缀保证，绝不把节点 UUID 写入配置。
+export function mihomoProxyName(name: string, index: number) {
+  return `${name}__${index}`;
+}
+export type ProbeNodeInput = {
+  id: string;
+  name: string;
+  node: any;
+};
+// 只在内存组装完整 Mihomo 配置，绝不 console.log、不落盘明文。
+// 代理字段映射与 packages/subscription 的 exportSubscription(mihomo) 分支保持一致。
+export function buildMihomoConfig(
+  nodes: ProbeNodeInput[],
+  opts: {
+    controllerSecret: string;
+    controllerPort?: number;
+    mixedPort?: number;
+    mode?: 'rule' | 'global';
+  },
+): string {
+  const proxies = nodes.map((input, i) => {
+    const n = input.node;
+    return {
+      name: mihomoProxyName(input.name, i),
+      type: n.protocol,
+      server: n.host,
+      port: n.port,
+      ...(['vless', 'vmess'].includes(n.protocol)
+        ? { uuid: n.credential }
+        : { password: n.credential }),
+      ...(n.cipher
+        ? { cipher: n.cipher }
+        : n.protocol === 'vmess'
+          ? { cipher: n.security || 'auto', alterId: n.alterId || 0 }
+          : {}),
+      tls: n.tls,
+      servername: n.sni,
+      network: n.transport,
+      ...(n.transport === 'ws'
+        ? {
+            'ws-opts': {
+              path: n.path || '/',
+              headers: { Host: n.wsHost || n.host },
+            },
+          }
+        : {}),
+    };
+  });
+  return stringify({
+    'external-controller': `127.0.0.1:${opts.controllerPort ?? 9090}`,
+    secret: opts.controllerSecret,
+    'mixed-port': opts.mixedPort ?? 7890,
+    mode: opts.mode ?? 'rule',
+    'log-level': 'warning',
+    proxies,
+    'proxy-groups': [
+      {
+        name: 'FAFA ONE',
+        type: 'select',
+        proxies: proxies.map((p) => p.name),
+      },
+      // global 模式下 Mihomo 走 GLOBAL 组；测速时逐节点切到该组实现单节点出站。
+      { name: 'GLOBAL', type: 'select', proxies: proxies.map((p) => p.name) },
+    ],
+    rules: ['MATCH,FAFA ONE'],
+  });
+}
