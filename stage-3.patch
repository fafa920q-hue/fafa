+test('仪表盘：四态各显示正确文案与颜色', async ({ page }) => {
+  test.skip(!dbUrl, '需要 TEST_DATABASE_URL 才能向 probe_results 插行');
+  await login(page);
+  const suffix = Date.now();
+  const specs: {
+    label: string;
+    status: 'OK' | 'TIMEOUT' | 'FAILED' | null;
+    row?: ProbeRowInput;
+    text: string;
