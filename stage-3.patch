diff --git a/apps/api/src/probe.ts b/apps/api/src/probe.ts
new file mode 100644
index 0000000..5be731f
--- /dev/null
+++ b/apps/api/src/probe.ts
@@ -0,0 +1,359 @@
+import type { FastifyInstance } from 'fastify';
+import { z } from 'zod';
+import {
+  activeGrant,
+  sourceAllowed,
+  withinNodeGrantScope,
+} from '../../../packages/auth/src/business-access';
+import { sql, audit } from '../../../packages/db/src';
+import { AppError, notFound, isAdmin } from '../../../packages/shared/src';
+
+// 阶段 3（节点探测）：探测设置、预算与共享查询助手。
+// 设置全部走 settings 表（key/value jsonb），不在迁移里插种子行；
+// 未配置的键一律用下面的代码默认值，首次读取时不写回。
+export const PROBE_DEFAULTS = {
+  latencyIntervalSeconds: 90,
+  speedIntervalSeconds: 3600,
+  dailyBudgetMb: 10240,
+  concurrency: 5,
+  timeoutSeconds: 30,
+  speedBytes: 5242880,
+  probePoint: 'kong-us-east-2',
+  retentionDays: 30,
+} as const;
+export const PROBE_DELAY_TARGET = 'https://www.gstatic.com/generate_204';
+export const PROBE_SPEED_URL = (bytes: number) =>
+  `https://speed.cloudflare.com/__down?bytes=${bytes}`;
+const clamp = (value: number, min: number, max: number) =>
+  Math.min(max, Math.max(min, value));
+const asNumber = (value: unknown, fallback: number) => {
+  const n = Number(value);
+  return Number.isFinite(n) ? n : fallback;
+};
+const asString = (value: unknown, fallback: string) =>
+  typeof value === 'string' && value ? value : fallback;
+export type ProbeSettings = {
+  latencyIntervalSeconds: number;
+  speedIntervalSeconds: number;
+  dailyBudgetMb: number;
+  concurrency: number;
+  timeoutSeconds: number;
+  speedBytes: number;
+  probePoint: string;
+  retentionDays: number;
+  dailyUsageMb: number;
+  usageDate: string;
+  lastLatencyAt: string | null;
+  lastSpeedAt: string | null;
+  lastRetentionAt: string | null;
+  lastRun: {
+    finishedAt: string;
+    ok: number;
+    total: number;
+    kind: string;
+  } | null;
+};
+export async function readProbeSettings(): Promise<ProbeSettings> {
+  const rows =
+    await sql`select key, value from settings where key like 'probe_%'`;
+  const byKey = new Map(rows.map((r: any) => [r.key, r.value]));
+  const usage =
+    byKey.get('probe_daily_usage') &&
+    typeof byKey.get('probe_daily_usage') === 'object'
+      ? (byKey.get('probe_daily_usage') as any)
+      : null;
+  const today = new Date().toISOString().slice(0, 10);
+  const lastRun =
+    byKey.get('probe_last_run') &&
+    typeof byKey.get('probe_last_run') === 'object'
+      ? (byKey.get('probe_last_run') as any)
+      : null;
+  return {
+    latencyIntervalSeconds: clamp(
+      asNumber(
+        byKey.get('probe_latency_interval_seconds'),
+        PROBE_DEFAULTS.latencyIntervalSeconds,
+      ),
+      60,
+      120,
+    ),
+    speedIntervalSeconds: clamp(
+      asNumber(
+        byKey.get('probe_speed_interval_seconds'),
+        PROBE_DEFAULTS.speedIntervalSeconds,
+      ),
+      300,
+      86400,
+    ),
+    dailyBudgetMb: Math.max(
+      0,
+      asNumber(
+        byKey.get('probe_daily_budget_mb'),
+        PROBE_DEFAULTS.dailyBudgetMb,
+      ),
+    ),
+    concurrency: clamp(
+      asNumber(byKey.get('probe_concurrency'), PROBE_DEFAULTS.concurrency),
+      1,
+      10,
+    ),
+    timeoutSeconds: clamp(
+      asNumber(
+        byKey.get('probe_timeout_seconds'),
+        PROBE_DEFAULTS.timeoutSeconds,
+      ),
+      5,
+      60,
+    ),
+    speedBytes: clamp(
+      asNumber(byKey.get('probe_speed_bytes'), PROBE_DEFAULTS.speedBytes),
+      1048576,
+      10485760,
+    ),
+    probePoint: asString(
+      byKey.get('probe_point'),
+      // 部署时可配：settings 键优先，其次环境变量，最后默认值。
+      asString(process.env.PROBE_POINT, PROBE_DEFAULTS.probePoint),
+    ),
+    // 探测结果保留期（天）：settings 键 probe_retention_days，clamp 1–365。
+    retentionDays: clamp(
+      asNumber(byKey.get('probe_retention_days'), PROBE_DEFAULTS.retentionDays),
+      1,
+      365,
+    ),
+    // 当日累计按 UTC 日期归属；日期不是今天即视为 0（由 Worker 写回时重置）。
+    dailyUsageMb:
+      usage?.date === today ? Math.max(0, asNumber(usage?.mb, 0)) : 0,
+    usageDate: today,
+    lastLatencyAt: asString(byKey.get('probe_last_latency_at'), '') || null,
+    lastSpeedAt: asString(byKey.get('probe_last_speed_at'), '') || null,
+    lastRetentionAt: asString(byKey.get('probe_last_retention_at'), '') || null,
+    lastRun:
+      lastRun && typeof lastRun.ok === 'number'
+        ? {
+            finishedAt: String(lastRun.finishedAt || ''),
+            ok: lastRun.ok,
+            total: Number(lastRun.total) || 0,
+            kind: String(lastRun.kind || ''),
+          }
+        : null,
+  };
+}
+export async function probeBudgetRemaining() {
+  const settings = await readProbeSettings();
+  const usedMb = settings.dailyUsageMb;
+  return {
+    limitMb: settings.dailyBudgetMb,
+    usedMb,
+    remainingMb: Math.max(0, settings.dailyBudgetMb - usedMb),
+  };
+}
+export function probeRowJson(row: any) {
+  return {
+    id: row.id,
+    nodeId: row.node_id,
+    probePoint: row.probe_point,
+    target: row.target,
+    startedAt: row.started_at,
+    finishedAt: row.finished_at,
+    status: row.status,
+    latencyMs: row.latency_ms,
+    downloadMbps: row.download_mbps == null ? null : Number(row.download_mbps),
+    uploadMbps: row.upload_mbps == null ? null : Number(row.upload_mbps),
+    errorCode: row.error_code,
+    errorMessage: row.error_message,
+    createdAt: row.created_at,
+  };
+}
+// 每节点最新一行 probe_results（一次查询，禁止每行一次查询）。
+export async function latestProbeByNode(
+  ids: string[],
+): Promise<Map<string, any>> {
+  const map = new Map<string, any>();
+  if (!ids.length) return map;
+  const rows =
+    await sql`select distinct on (node_id) * from probe_results where node_id = any(${ids}::uuid[]) order by node_id, created_at desc`;
+  for (const row of rows) map.set(row.node_id, row);
+  return map;
+}
+// 与 GET /api/nodes 同一套可见规则：本人节点，或有有效授权。
+// Owner/Admin 可见任意未撤销节点（探测是管理动作，不走订阅授权）。
+export async function visibleNodeIds(actor: any): Promise<string[]> {
+  if (isAdmin(actor.role)) {
+    const rows =
+      await sql`select n.id from nodes n join node_sources s on s.id=n.source_id join users u on u.id=s.owner_id where n.revoked_at is null and s.revoked_at is null and not u.disabled and u.deleted_at is null`;
+    return rows.map((r: any) => r.id);
+  }
+  const rows =
+    await sql`select n.*,s.data as source_data,g.data as grant_data from nodes n join node_sources s on s.id=n.source_id join users u on u.id=s.owner_id left join node_group_grants g on g.source_id=s.id and g.user_id=${actor.id} and g.revoked_at is null where n.revoked_at is null and s.revoked_at is null and not u.disabled and u.deleted_at is null and (s.owner_id=${actor.id} or ((s.data->>'kind'='OWNED_NODE' or (s.data->>'authorized'='true' and s.data->>'redistributionAuthorized'='true' and length(trim(coalesce(s.data->>'authorizationReference','')))>0)) and g.id is not null)) order by n.created_at limit 5000`;
+  return rows
+    .filter((row: any) => {
+      const group = row.data.group || row.source_data.group || '';
+      return (
+        row.owner_id === actor.id ||
+        (row.grant_data &&
+          activeGrant(row.grant_data) &&
+          sourceAllowed(actor, row.source_id, group) &&
+          withinNodeGrantScope(row.grant_data, row.id, group))
+      );
+    })
+    .map((row: any) => row.id);
+}
+export async function visibleNodeFor(actor: any, nodeId: string) {
+  if (isAdmin(actor.role)) {
+    const [row] =
+      await sql`select n.* from nodes n join node_sources s on s.id=n.source_id join users u on u.id=s.owner_id where n.id=${nodeId} and n.revoked_at is null and s.revoked_at is null and not u.disabled and u.deleted_at is null`;
+    return row || null;
+  }
+  const [row] =
+    await sql`select n.*,s.data as source_data,g.data as grant_data from nodes n join node_sources s on s.id=n.source_id join users u on u.id=s.owner_id left join node_group_grants g on g.source_id=s.id and g.user_id=${actor.id} and g.revoked_at is null where n.id=${nodeId} and n.revoked_at is null and s.revoked_at is null and not u.disabled and u.deleted_at is null and (s.owner_id=${actor.id} or ((s.data->>'kind'='OWNED_NODE' or (s.data->>'authorized'='true' and s.data->>'redistributionAuthorized'='true' and length(trim(coalesce(s.data->>'authorizationReference','')))>0)) and g.id is not null))`;
+  if (!row) return null;
+  const group = row.data.group || row.source_data.group || '';
+  if (
+    row.owner_id === actor.id ||
+    (row.grant_data &&
+      activeGrant(row.grant_data) &&
+      sourceAllowed(actor, row.source_id, group) &&
+      withinNodeGrantScope(row.grant_data, row.id, group))
+  )
+    return row;
+  return null;
+}
+// 探测范围：未撤销、来源未撤销且启用、节点未禁用、来源未过期、
+// 来源 kind 为 OWNED_NODE 或授权完整的第三方源。
+// 与 apps/worker 的 runProbeJob 共用同一 SQL，改动只改这一处。
+export async function probeEligibleNodeRows() {
+  return sql`select n.*,s.data as source_data from nodes n join node_sources s on s.id=n.source_id join users u on u.id=s.owner_id where n.revoked_at is null and s.revoked_at is null and not u.disabled and u.deleted_at is null and coalesce(s.data->>'enabled','true')='true' and n.data->>'enabled' is distinct from 'false' and (s.data->>'expiresAt' is null or (s.data->>'expiresAt')::timestamptz>now()) and (s.data->>'kind'='OWNED_NODE' or (s.data->>'authorized'='true' and s.data->>'redistributionAuthorized'='true' and length(trim(coalesce(s.data->>'authorizationReference','')))>0)) order by n.created_at`;
+}
+// 与 apps/probe/src/probe.ts 的 isProbeEligible 同口径的原因版：
+// 返回 null 表示可探测，否则返回应向调用方展示的原因文案。
+// isProbeEligible 只返回 boolean，手动重测需要区分原因，故此处按同一
+// 条件逐项判断；改动任一处时须同步另一处与 probeEligibleNodeRows。
+// 来源行缺失时视为未获授权（visibleNodeFor 的 join 本已保证来源存在）。
+export function probeIneligibilityReason(
+  node: any,
+  source: any,
+): string | null {
+  const n = node?.data || {};
+  const s = source?.data || {};
+  if (n.enabled === false) return '该节点已停用，无法探测';
+  if (s.enabled === false) return '所属订阅源已停用，无法探测';
+  if (s.expiresAt && new Date(s.expiresAt) <= new Date())
+    return '所属订阅源已过期，无法探测';
+  if (s.kind === 'OWNED_NODE') return null;
+  return s.authorized === true &&
+    s.redistributionAuthorized === true &&
+    Boolean(s.authorizationReference?.trim())
+    ? null
+    : '该节点未获授权，无法探测';
+}
+export async function registerProbe(app: FastifyInstance) {
+  app.post('/api/nodes/:id/probe', async (req) => {
+    const { id } = z.object({ id: z.uuid() }).parse(req.params);
+    const node = await visibleNodeFor(req.actor, id);
+    if (!node) throw notFound();
+    // 资格预检（在限流与预算检查之前）：已停用/过期/未授权的节点，
+    // Worker 会静默跳过，此处直接给调用方明确反馈。
+    // visibleNodeFor 对管理员只返回 n.*，来源行需单独查一次。
+    const [source] =
+      await sql`select * from node_sources where id=${node.source_id}`;
+    const reason = probeIneligibilityReason(node, source || null);
+    if (reason) throw new AppError(409, 'NODE_NOT_PROBEABLE', reason);
+    const [recent] =
+      await sql`select id from probe_results where node_id=${id} and created_at>now()-interval '60 seconds' limit 1`;
+    const [pending] =
+      await sql`select id from background_jobs where data->>'type'='PROBE_LATENCY' and data->>'nodeId'=${id} and data->>'status' in ('QUEUED','RUNNING') and revoked_at is null limit 1`;
+    if (recent || pending)
+      throw new AppError(
+        429,
+        'PROBE_RATE_LIMIT',
+        '该节点 1 分钟内只能重测一次，请稍后重试',
+      );
+    const budget = await probeBudgetRemaining();
+    if (budget.remainingMb <= 0)
+      throw new AppError(
+        409,
+        'PROBE_BUDGET_EXCEEDED',
+        '今日探测预算已耗尽，请明日再试或联系管理员',
+      );
+    const [job] =
+      await sql`insert into background_jobs(owner_id,source_id,data) values(${req.actor.id},null,${sql.json({ type: 'PROBE_LATENCY', status: 'QUEUED', attempt: 0, nextRun: new Date().toISOString(), nodeId: id, manual: true, requestedBy: req.actor.id })}) returning id`;
+    await audit(req.actor.id, 'probe.manual_queued', id, req.id);
+    return { jobId: job.id, nodeId: id, queued: true };
+  });
+  app.post('/api/probe/run-all', async (req) => {
+    if (!isAdmin(req.actor.role))
+      throw new AppError(403, 'FORBIDDEN', '需要管理员权限');
+    const budget = await probeBudgetRemaining();
+    if (budget.remainingMb <= 0)
+      throw new AppError(
+        409,
+        'PROBE_BUDGET_EXCEEDED',
+        '今日探测预算已耗尽，请明日再试或联系管理员',
+      );
+    const eligible = await probeEligibleNodeRows();
+    const [job] =
+      await sql`insert into background_jobs(owner_id,source_id,data) values(${req.actor.id},null,${sql.json({ type: 'PROBE_LATENCY', status: 'QUEUED', attempt: 0, nextRun: new Date().toISOString(), all: true, manual: true, requestedBy: req.actor.id })}) returning id`;
+    await audit(req.actor.id, 'probe.run_all_queued', job.id, req.id);
+    return { jobId: job.id, queuedNodes: eligible.length };
+  });
+  app.get('/api/nodes/:id/probe-history', async (req) => {
+    const { id } = z.object({ id: z.uuid() }).parse(req.params);
+    const { limit } = z
+      .object({
+        limit: z.coerce.number().int().min(1).max(200).default(50),
+      })
+      .parse(req.query);
+    const node = await visibleNodeFor(req.actor, id);
+    if (!node) throw notFound();
+    const rows =
+      await sql`select * from probe_results where node_id=${id} order by created_at desc limit ${limit}`;
+    return rows.map(probeRowJson);
+  });
+  app.get('/api/probe/status', async (req) => {
+    const settings = await readProbeSettings();
+    const [lastFinished] =
+      await sql`select max(finished_at) as last_finished_at from probe_results`;
+    const [queued] =
+      await sql`select count(*)::int as total from background_jobs where revoked_at is null and data->>'type' in ('PROBE_LATENCY','PROBE_SPEED') and data->>'status'='QUEUED'`;
+    const [running] =
+      await sql`select count(*)::int as total from background_jobs where revoked_at is null and data->>'type' in ('PROBE_LATENCY','PROBE_SPEED') and data->>'status'='RUNNING'`;
+    const [failures] =
+      await sql`select count(*)::int as total from probe_results where created_at>now()-interval '24 hours' and status<>'OK'`;
+    return {
+      probePoint: settings.probePoint,
+      lastFinishedAt: lastFinished.last_finished_at ?? null,
+      queued: queued.total,
+      running: running.total,
+      budgetRemainingMb: Math.max(
+        0,
+        settings.dailyBudgetMb - settings.dailyUsageMb,
+      ),
+      budgetLimitMb: settings.dailyBudgetMb,
+      recentFailures: failures.total,
+      lastRunOk: settings.lastRun ? settings.lastRun.ok : null,
+    };
+  });
+  app.get('/api/probe/runs', async (req) => {
+    const q = z
+      .object({
+        nodeId: z.uuid().optional(),
+        status: z.enum(['OK', 'TIMEOUT', 'FAILED']).optional(),
+        limit: z.coerce.number().int().min(1).max(200).default(50),
+        offset: z.coerce.number().int().min(0).default(0),
+      })
+      .parse(req.query);
+    if (q.nodeId) {
+      const node = await visibleNodeFor(req.actor, q.nodeId);
+      if (!node) throw notFound();
+    }
+    const admin = isAdmin(req.actor.role);
+    const visibleIds = admin ? [] : await visibleNodeIds(req.actor);
+    const where = sql`(${q.nodeId ?? null}::uuid is null or node_id=${q.nodeId ?? null}::uuid) and (${q.status ?? null}::text is null or status=${q.status ?? null}::text) and (${admin}::boolean or node_id=any(${visibleIds}::uuid[]))`;
+    const rows =
+      await sql`select * from probe_results where ${where} order by created_at desc limit ${q.limit} offset ${q.offset}`;
+    const [count] =
+      await sql`select count(*)::int as total from probe_results where ${where}`;
+    return { items: rows.map(probeRowJson), total: count.total };
+  });
+}
