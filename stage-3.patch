+// 阶段 3（节点探测）e2e：显示层验证。
+// 做法：先经 API 导入 fixture 节点，再直接向 probe_results 插行，刷新页面断言显示。
+// 真实探测往返（Mihomo 真跑、真实延迟/下载）不在 e2e 里跑，只在 Kong 手动验收做。
+// 插行需要直连开发服务器所用的数据库：Kong 上跑 e2e 时须导出 TEST_DATABASE_URL
+//（与开发服务器的 DATABASE_URL 相同）；未导出时插行用例跳过，手动重测用例仍可跑。
+// 凭据一律用明显假值，不得放真实节点密码/UUID。
+
+const webOrigin = 'http://localhost:5173';
+const dbUrl = process.env.TEST_DATABASE_URL || process.env.DATABASE_URL || '';
+
+async function login(page: Page, profile = '管理员演示') {
+  await page.route('https://tile.openstreetmap.org/**', (r: any) => r.abort());
+  await page.goto('/');
+  await page.getByRole('button', { name: profile, exact: true }).click();
+  await expect(page.getByRole('heading', { name: /欢迎回来/ })).toBeVisible();
+}
+
+async function api(page: Page, path: string, method = 'GET', body?: unknown) {
+  const client = page.context().request;
+  const me = await client.get(webOrigin + '/api/me', { timeout: 5000 });
+  expect(me.status()).toBe(200);
+  const session = await me.json();
+  const response = await client.fetch(webOrigin + path, {
+    method,
+    timeout: 5000,
+    headers: {
+      origin: webOrigin,
+      ...(!['GET', 'HEAD'].includes(method)
+        ? { 'x-csrf-token': session.csrf }
+        : {}),
+    },
+    ...(body === undefined ? {} : { data: body }),
+  });
+  return { status: response.status(), data: await response.json() };
+}
+
+function ssLink(name: string) {
+  return (
+    'ss://' +
+    Buffer.from('aes-256-gcm:fictional-fixture-password').toString(
+      'base64url',
+    ) +
+    '@node.example.com:8388#' +
+    encodeURIComponent(name)
+  );
+}
+
+async function importFixtureNode(page: Page, name: string) {
+  const imported = await api(page, '/api/node-import', 'POST', {
+    name: '探测 e2e ' + name,
+    group: '',
+    kind: 'THIRD_PARTY_NODE',
+    content: ssLink(name),
+    authorized: true,
+    redistributionAuthorized: true,
+    authorizationReference: '虚构提供商授权 fixture',
+  });
+  expect(imported.status, JSON.stringify(imported.data)).toBe(200);
+  const sourceId = imported.data.sourceId as string;
+  const nodes = await api(page, '/api/nodes');
+  const node = nodes.data.find((n: any) => n.sourceId === sourceId);
+  expect(node?.id).toBeTruthy();
+  return { sourceId, nodeId: node.id as string, name: node.name as string };
+}
+
+type ProbeRowInput = {
+  status: 'OK' | 'TIMEOUT' | 'FAILED';
+  latencyMs?: number | null;
+  downloadMbps?: number | null;
+  errorCode?: string | null;
+  errorMessage?: string | null;
+};
+
+async function insertProbeRow(nodeId: string, row: ProbeRowInput) {
+  const db = postgres(dbUrl);
+  try {
+    const now = new Date().toISOString();
+    await db`insert into probe_results(node_id,probe_point,target,started_at,finished_at,status,latency_ms,download_mbps,upload_mbps,error_code,error_message) values(${nodeId},${'kong-us-east-2'},${'https://www.gstatic.com/generate_204'},${now},${now},${row.status},${row.latencyMs ?? null},${row.downloadMbps ?? null},${null},${row.errorCode ?? null},${row.errorMessage ?? null})`;
+  } finally {
+    await db.end();
+  }
+}
+
+async function cleanup(sourceIds: string[], nodeIds: string[]) {
+  if (!dbUrl) return;
+  const db = postgres(dbUrl);
+  try {
+    if (nodeIds.length) {
+      await db`delete from probe_results where node_id = any(${nodeIds})`;
+      await db`delete from background_jobs where data->>'nodeId' = any(${nodeIds})`;
+    }
+    if (sourceIds.length)
+      await db`update node_sources set revoked_at=now() where id = any(${sourceIds})`;
+  } finally {
+    await db.end();
+  }
+}
