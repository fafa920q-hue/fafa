NODE_ENV=development
DEMO_MODE=true
DEV_MOCK_LOGIN=true
DATABASE_URL=postgres://fafa:fafa_dev_only@localhost:5432/fafa
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
API_PUBLIC_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
BOOTSTRAP_ADMIN_GOOGLE_SUB=
# 使用 pnpm exec tsx infra/scripts/init-env.ts 生成本地加密密钥，不可将真实 .env 提交
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=v1
SSH_ALLOWED_TARGETS=
OPENAI_MODEL=gpt-4.1-mini

# 默认 host-only；管理端直接请求主域名 API，无需共享父域 Cookie。
# 已有部署若使用受控父域 Cookie，可保留此配置
COOKIE_DOMAIN=
# 默认不开放交互式写入终端
SSH_INTERACTIVE_ENABLED=false
# 轮换时注入旧 key ID 到 base64 主密钥的 JSON 映射
ENCRYPTION_PREVIOUS_KEYS_JSON=
