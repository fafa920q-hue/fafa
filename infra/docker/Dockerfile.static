# syntax=docker/dockerfile:1
# Compose supplies the already-built API image as this named build context.
FROM runtime AS artifacts
FROM caddy:2.10.2-alpine AS web
COPY --from=artifacts /app/apps/web/dist /srv
COPY --from=artifacts /app/LICENSE /app/docs/THIRD_PARTY_NOTICES.txt /srv/
COPY infra/docker/Caddyfile.static /etc/caddy/Caddyfile
USER 1000:1000
EXPOSE 8080
FROM caddy:2.10.2-alpine AS admin
COPY --from=artifacts /app/apps/admin/dist /srv
COPY --from=artifacts /app/LICENSE /app/docs/THIRD_PARTY_NOTICES.txt /srv/
COPY infra/docker/Caddyfile.static /etc/caddy/Caddyfile
USER 1000:1000
EXPOSE 8080
